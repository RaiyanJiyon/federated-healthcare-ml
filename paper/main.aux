\@writefile{lot}{\contentsline {table}{\numberline {IV}{\ignorespaces Byzantine robustness on MIMIC-IV convergence study (20 rounds, 7 ICU clients, raw model outputs without Platt calibration). Each aggregation method (FedAvg, FedProx, Median, Krum, FedF2) runs for 20 rounds without recalibration to test convergence under adversarial conditions. Results show test AUROC under clean conditions and label-flip attacks with 1, 2, or 3 malicious clients. Note: FedProx AUROC differs from Table~\ref {tab:performance} (0.7721 vs 0.8591) due to 20 rounds vs 5 rounds and absence of Platt calibration.}}{12}{table.4}\protected@file@percent }
\newlabel{tab:byzantine_robustness}{{IV}{12}{Byzantine robustness on MIMIC-IV convergence study (20 rounds, 7 ICU clients, raw model outputs without Platt calibration). Each aggregation method (FedAvg, FedProx, Median, Krum, FedF2) runs for 20 rounds without recalibration to test convergence under adversarial conditions. Results show test AUROC under clean conditions and label-flip attacks with 1, 2, or 3 malicious clients. Note: FedProx AUROC differs from Table~\ref {tab:performance} (0.7721 vs 0.8591) due to 20 rounds vs 5 rounds and absence of Platt calibration}{table.4}{}}
