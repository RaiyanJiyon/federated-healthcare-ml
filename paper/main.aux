\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces System scalability and network robustness analysis. \textit  {Left:} AUROC (blue, left axis) remains stable above 0.88 as the number of participating clients scales from 7 to 28; throughput (orange, right axis) decreases due to synchronous-aggregation straggler effects. \textit  {Right:} AUROC under 10--30\% random client dropout; throughput increases with higher dropout because fewer clients respond per round, reducing per-round aggregation latency.}}{7}{figure.2}\protected@file@percent }
\newlabel{fig:comprehensive}{{2}{7}{System scalability and network robustness analysis. \textit {Left:} AUROC (blue, left axis) remains stable above 0.88 as the number of participating clients scales from 7 to 28; throughput (orange, right axis) decreases due to synchronous-aggregation straggler effects. \textit {Right:} AUROC under 10--30\% random client dropout; throughput increases with higher dropout because fewer clients respond per round, reducing per-round aggregation latency}{figure.2}{}}
\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Federated learning performance on MIMIC-IV baseline validation (5 rounds, 7 ICU clients). All federated results use balanced logistic regression with Platt calibration applied to decision threshold (0.39). The DP row reflects the corrected per-sample DP-SGD pipeline at $\epsilon =4.36$, $\delta =10^{-5}$ (verified via moments accountant for $T=20$ rounds, then evaluated at 5 rounds with Platt calibration); DP-SGD pre-calibration AUROC at 5 rounds is 0.8646.}}{7}{table.1}\protected@file@percent }
\newlabel{tab:performance}{{I}{7}{Federated learning performance on MIMIC-IV baseline validation (5 rounds, 7 ICU clients). All federated results use balanced logistic regression with Platt calibration applied to decision threshold (0.39). The DP row reflects the corrected per-sample DP-SGD pipeline at $\epsilon =4.36$, $\delta =10^{-5}$ (verified via moments accountant for $T=20$ rounds, then evaluated at 5 rounds with Platt calibration); DP-SGD pre-calibration AUROC at 5 rounds is 0.8646}{table.1}{}}
\citation{zhu2019deep}
\citation{shokri2016membership}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Systematic ablation and calibration evaluation of FedF2 vs. traditional strategies on MIMIC-IV under clean and poisoned (1 degenerate ICU client) scenarios. ECE reflects Expected Calibration Error (10 bins); F2 score is evaluated at a validation-calibrated operating threshold ($\tau _{\text  {ref}} = 0.39$ for calibrated models, $\tau _{\text  {ref}} = 0.05$ for uncalibrated models).}}{8}{table.2}\protected@file@percent }
\newlabel{tab:clinical_aggregation}{{II}{8}{Systematic ablation and calibration evaluation of FedF2 vs. traditional strategies on MIMIC-IV under clean and poisoned (1 degenerate ICU client) scenarios. ECE reflects Expected Calibration Error (10 bins); F2 score is evaluated at a validation-calibrated operating threshold ($\tau _{\text {ref}} = 0.39$ for calibrated models, $\tau _{\text {ref}} = 0.05$ for uncalibrated models)}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Calibration and precision-recall analysis. Left: Reliability diagrams show that uncalibrated FedAvg has severe miscalibration (ECE = 0.2338), while Platt scaling recovers reliability (ECE $<$ 0.01) across all aggregation methods. Right: Precision-Recall curves demonstrate that calibrated methods maintain similar diagnostic utility (AUPRC $\approx 0.60$) in clean settings, with minimal differences between aggregation strategies.}}{8}{figure.3}\protected@file@percent }
\newlabel{fig:calibration_and_pr}{{3}{8}{Calibration and precision-recall analysis. Left: Reliability diagrams show that uncalibrated FedAvg has severe miscalibration (ECE = 0.2338), while Platt scaling recovers reliability (ECE $<$ 0.01) across all aggregation methods. Right: Precision-Recall curves demonstrate that calibrated methods maintain similar diagnostic utility (AUPRC $\approx 0.60$) in clean settings, with minimal differences between aggregation strategies}{figure.3}{}}
